# PandaBlog local development environment.
# Copy to .env and fill in the required secrets before running npm run dev:
#   cp .env.example .env
# Only these canonical NUXT_ names are supported; no deprecated aliases.
# Use local secrets and a local DB target, never production credentials here.
# Nuxt dev loads .env. A standalone built server requires process environment;
# see deploy/production/.env.example for the container deployment template.

# --- SurrealDB connection and first-run ROOT bootstrap ---------------------
NUXT_SURREAL_URL="ws://127.0.0.1:8000/rpc"
NUXT_SURREAL_NAMESPACE="main"
NUXT_SURREAL_DATABASE="main"
NUXT_SURREAL_ROOT="root"
# ROOT creates a missing namespace/database/scoped user, then closes.
# Existing users are NOT overwritten or password-reset during normal startup.
# All table schemas/migrations use the scoped user. Keep ROOT configured when
# using current privileged backup/restore; removing it only supports ordinary
# startup without those maintenance operations.
# Match the independently configured local SurrealDB ROOT password.
NUXT_SURREAL_ROOT_PASSWORD=""

# --- Scoped runtime identity (required in development AND production) ------
# Owned boot provisions this DATABASE-scoped EDITOR before runtime sign-in.
# No ordinary runtime ROOT fallback. Use a separate strong password.
# User starts with a letter/_ and contains only letters/digits/underscores.
NUXT_SURREAL_APP_USER="pandablog_app"
NUXT_SURREAL_APP_PASSWORD=""

# --- Canonical browser origin ---------------------------------------------
# Exact scheme + host + port; no path. Required in production.
NUXT_APP_ORIGIN="http://127.0.0.1:3000"

# --- Session encryption (required: 32+ random characters) ------------------
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=""

# --- Optional MFA encryption key ------------------------------------------
# Falls back to the session key when unset. Changing either key can invalidate
# existing encrypted TOTP secrets; do not rotate them as incidental cleanup.
# NUXT_MFA_SECRET=""

# --- Public footer attribution --------------------------------------------
# Show "Powered by PandaBlog" with its GitHub link; default false.
NUXT_PUBLIC_FOOTER_SHOW_POWERED_BY=false

# --- Node runtime tuning (process variable, not NUXT_-prefixed) ------------
# Set this in the launching shell/container environment before Node starts;
# loading .env after launch does not resize the current Node process heap.
NODE_OPTIONS="--max-old-space-size=4096"

# --- Optional authenticated Playwright E2E tests ---------------------------
# Existing application-admin credentials, NOT database/scoped credentials.
# Empty values skip authenticated tests; they do not create an admin account.
# Prefer a disposable test deployment, not a live production account.
E2E_ADMIN_USERNAME=""
E2E_ADMIN_PASSWORD=""

# --- Console logging (process variables; intentionally not NUXT_-prefixed) --
# LOG_CONSOLE: off | errors | all. LOG_FORMAT: json | pretty.
LOG_CONSOLE=errors
LOG_FORMAT=pretty

# Liveness: GET /api/health. Readiness: GET /api/ready.
# Invalid/missing credentials keep startup fenced; never delete ownership
# receipts or recovery artifacts to force startup.
