# Pandablog production environment file.
# Copy to ".env" next to docker-compose.yml and fill in real values.
#
#   cp .env.example .env
#
# NOTE: Nuxt/Nitro reads these at runtime. The .env file in /opt/.../pandablog-single
# is read by the container via env_file. NUXT_SURREAL_ROOT / NUXT_SURREAL_ROOT_PASSWORD
# MUST match the SURREAL_USER / SURREAL_PASS used by the surrealdb container.

# --- SurrealDB connection -------------------------------------------------
# Both pandablog-app and surrealdb share the external "nginx" docker network,
# so the app reaches the DB by container name over plain ws:// (no TLS needed
# on the internal hop; TLS is terminated by nginx at the edge).
#
# IMPORTANT: use canonical NUXT_-prefixed names in development and production.
# Deprecated unprefixed/attribution aliases are not supported.
NUXT_SURREAL_URL="ws://surrealdb:8000/rpc"
NUXT_SURREAL_NAMESPACE="main"
NUXT_SURREAL_DATABASE="main"
NUXT_SURREAL_ROOT="root"                 # must equal surrealdb's SURREAL_USER
NUXT_SURREAL_ROOT_PASSWORD=""            # required: must equal surrealdb's SURREAL_PASS

# ROOT password is needed for first-run namespace/database/user provisioning.
# ROOT closes before scoped schema/migrations; normal startup does not overwrite
# existing scoped users or rotate their passwords. Keep ROOT for current privileged
# backup/restore. ROOT-free ordinary startup is optional, not full-feature maintenance.

# --- Scoped runtime user (required in development AND production) ---------
# Ordinary traffic uses a DATABASE-scoped EDITOR; there is no ROOT fallback.
# Missing/partial/invalid credentials fence startup before privileged work.
# Owned boot provisions/updates this identity before the first runtime sign-in.
# All ordinary boot schemas/migrations use this scoped user, not ROOT.
# ROOT is only for explicit bootstrap or currently privileged backup/restore.
# EDITOR still has broad permissions inside the selected database.
# Identifier starts with a letter/_ and contains only letters/digits/underscore.
# Supply a separate strong secret; required secret fields are deliberately empty.
NUXT_SURREAL_APP_USER="pandablog_app"
NUXT_SURREAL_APP_PASSWORD=""

# --- Canonical browser origin (required) ----------------------------------
# Exact externally visible scheme + host + port. Do not include a path.
# Production startup refuses a missing/invalid value; forwarded headers never
# establish this trust boundary. Non-browser mutation clients must explicitly
# send X-PandaBlog-Client: non-browser when Origin/Fetch Metadata are absent.
NUXT_APP_ORIGIN="https://blog.example.com"

# --- Session encryption ---------------------------------------------------
# MUST be 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=""

# --- Two-factor authentication (TOTP) -------------------------------------
# Optional. Encrypts TOTP secrets at rest. If unset, NUXT_SESSION_PASSWORD is
# used instead. Rotating this value (or the session password when this is
# unset) invalidates all stored TOTP secrets and forces users to re-enrol.
# NUXT_MFA_SECRET="change-me-to-a-separate-strong-random-secret"

# --- Runtime tuning -------------------------------------------------------
# V8 old-space heap cap. Tune per host in the live .env file. 1024 MB is the
# current conservative value for a 2 GB server with co-located SurrealDB.
# NOTE: no NUXT_ prefix here — NODE_OPTIONS is read by the Node.js runtime
# itself (not Nitro's runtimeConfig), so the name is fixed by Node.
NODE_OPTIONS="--max-old-space-size=1024"

# --- Console logging ------------------------------------------------------
# Plain names (no NUXT_ prefix): read by the logging subsystem at startup.
# LOG_CONSOLE: off | errors | all (default: errors).
# errors prints errors/warnings to stderr; all also prints activity/app info to
# stdout. The admin console_output toggle upgrades errors to all, but cannot
# override off. These vars control console output, not DB storage.
LOG_CONSOLE=errors
# LOG_FORMAT: json | pretty (default: json in production, pretty otherwise).
# Keep json for one JSON object per line in docker logs; pretty is for humans.
LOG_FORMAT=json
# Recreate the app container after changing these values; restart alone does
# not reload this env_file. Docker rotation is set in docker-compose.yml.

# --- Image override (optional) --------------------------------------------
# PANDABLOG_IMAGE="pandablog-single:latest"


# --- Public footer attribution --------------------------------------------
# Show “Powered by PandaBlog” linking to GitHub; not a payment/sponsor feature.
NUXT_PUBLIC_FOOTER_SHOW_POWERED_BY=false

# Liveness: GET /api/health. Readiness: GET /api/ready (200 only when ready).
# Startup failures remain fenced; never delete receipts to force startup.