{
  "name": "pandablog",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "panda": "node bin/panda.mjs",
    "recover": "node bin/panda.mjs recover",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --quiet && npm run lint:style-drift",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"assets/**/*.css\" \"themes/**/*.css\" \"components/**/*.vue\" --quiet",
    "lint:style-drift": "node scripts/check-style-drift.mjs",
    "lint:style-drift:update": "node scripts/check-style-drift.mjs --update",
    "version:print": "node scripts/version.mjs",
    "container:build": "node scripts/docker-build.mjs",
    "docker:build": "node scripts/docker-build.mjs --engine=docker",
    "podman:build": "node scripts/docker-build.mjs --engine=podman",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:backend:integration": "tsx scripts/backend-hardening/run.ts",
    "hardening:acceptance:report": "tsx scripts/backend-hardening/release.ts --report --stage=postdeploy",
    "hardening:acceptance:check:local": "tsx scripts/backend-hardening/release.ts --check --stage=local",
    "hardening:acceptance:check": "tsx scripts/backend-hardening/release.ts --check --stage=predeploy",
    "hardening:acceptance:check:postdeploy": "tsx scripts/backend-hardening/release.ts --check --stage=postdeploy",
    "typecheck": "nuxt typecheck",
    "hash-password": "tsx scripts/hash-password.ts"
  },
